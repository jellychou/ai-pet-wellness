APP_NAME=ai-pet-wellness-api
DEBUG=true

# Postgres 連線字串。
# 本機（docker-compose）：postgresql+psycopg2://postgres:postgres@localhost:5432/ai_pet_wellness
# Neon（雲端）：去 https://neon.tech 建立 Project 後，從 Dashboard 複製 Connection string，
#   把開頭的 postgresql:// 換成 postgresql+psycopg2://，並保留結尾的 ?sslmode=require
DATABASE_URL=postgresql+psycopg2://neondb_owner:npg_gawN8JBTh5Oc@ep-twilight-hall-aync7sxa-pooler.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# 前端開發伺服器網址，逗號分隔可放多個
CORS_ORIGINS=http://localhost:5173

# 簽發自家 session JWT 用的密鑰，正式環境請換成隨機長字串，例如：openssl rand -hex 32
JWT_SECRET_KEY=dev-only-change-me

# 前端網址，組「忘記密碼」信件裡的重設連結用
FRONTEND_BASE_URL=http://localhosst:5173

# 重設密碼 token 有效時間（分鐘）
RESET_TOKEN_EXPIRES_MINUTES=30
