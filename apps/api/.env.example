APP_NAME=ai-pet-wellness-api
DEBUG=true

# Postgres 連線字串。
# 本機（docker-compose）：postgresql+psycopg2://postgres:postgres@localhost:5432/ai_pet_wellness
# Neon（雲端）：去 https://neon.tech 建立 Project 後，從 Dashboard 複製 Connection string，
#   把開頭的 postgresql:// 換成 postgresql+psycopg2://，並保留結尾的 ?sslmode=require
DATABASE_URL=postgresql+psycopg2://<user>:<password>@<endpoint>.neon.tech/<dbname>?sslmode=require

# 前端網址，逗號分隔可放多個。CORS_ORIGINS 只填 origin（不含路徑）；
# FRONTEND_BASE_URL 要包含 GitHub Pages 的 repo 路徑（組重設密碼連結用），結尾不要加斜線
CORS_ORIGINS=https://jellychou.github.io
FRONTEND_BASE_URL=https://jellychou.github.io/ai-pet-wellness

# 簽發自家 session JWT 用的密鑰，正式環境請換成隨機長字串，例如：openssl rand -hex 32
JWT_SECRET_KEY=dev-only-change-me

# 跟前端用同一組 Google OAuth Client ID（去 Google Cloud Console 的憑證頁面拿）
GOOGLE_CLIENT_ID=176862427478-oij6fn6tvg5li3rf88kn3dluh92p3h7h.apps.googleusercontent.com

# 重設密碼 token 有效時間（分鐘）
RESET_TOKEN_EXPIRES_MINUTES=30

# 忘記密碼信：走 Gmail SMTP 寄送。不設的話會退回只印到 log 的 dev 版本。
# 建議申請一個全新的、專門給這個 App 用的 Gmail 帳號，不要用私人信箱。
# SMTP_PASSWORD 要用 Gmail「應用程式密碼」，不是登入密碼：
# 這個 Gmail 帳號要先開兩步驟驗證，再到 https://myaccount.google.com/apppasswords 產生一組 16 碼密碼
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=Food・Heart
SMTP_FROM_EMAIL=
