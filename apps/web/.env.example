# 後端 API 網址（本機開發預設 FastAPI 跑在 8000 port）
VITE_API_BASE_URL=https://ai-pet-wellness.onrender.com

# Google OAuth Client ID，跟後端 .env 的 GOOGLE_CLIENT_ID 要是同一組
VITE_GOOGLE_CLIENT_ID=176862427478-oij6fn6tvg5li3rf88kn3dluh92p3h7h.apps.googleusercontent.com

# 頭貼上傳走 Cloudinary（不是存 base64 進資料庫），前端直接上傳到
# Cloudinary、不經過我們自己的後端。cloud name 跟 unsigned upload preset
# 名稱本來就是設計成可以放在前端程式碼裡曝光的東西，不是密鑰。
# 去 Cloudinary 主控台 Settings > Upload > Upload presets 建一個
# Signing Mode 為 Unsigned 的 preset
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
